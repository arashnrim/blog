<!-- This is a hacky workaround to inject custom styling to @astrojs/mdx's rendition
of MDX content. The styles are scoped to the #post-content element, which is the
container for the MDX content in the PostLayout component. -->
<style is:inline>
  #post-content {
    max-width: 920px;

    hr {
      border: none;
      margin-left: 0;
      margin-right: 0;
    }

    hr::before {
      content: "***";
      font-family: var(--mono);
      color: #848484;
      display: block;
      text-align: center;
    }

    /* :not(.frame) is used here to avoid conflicting with Expressive Code, which uses frames to style code blocks. */
    figure:not(.frame) {
      margin: 1em 0;
      border: 3px solid #1f1f1f;
      border-radius: var(--radius);
      padding: 1em;
      width: fit-content;
    }

    /* Handles the case of nested figures; since all figures have vertical margins, we remove the vertical padding from the outer figure. */
    figure:not(.frame):has(figure) {
      padding: 0 1em;
    }

    figure img {
      max-width: 100%;
      border-radius: 0.5em;
      pointer-events: none;
    }

    figure img::selection {
      background-color: transparent;
    }

    figure figcaption {
      margin-top: 0.5em;
      color: #848484;
    }

    iframe {
      border: 3px solid #1f1f1f;
      border-radius: var(--radius);
      width: 100%;
      aspect-ratio: 16 / 9;
    }

    blockquote {
      margin-left: 0;
      margin-right: 0;
      padding: 0.1em 2em;
      border: 3px solid #2a2a2a;
      border-left: 5px solid #2a2a2a;
      background-color: #0c0c0c;
      border-radius: 0 var(--radius) var(--radius) 0;
    }

    .prompt {
      margin: 0 -2em;
    }

    .prompt > * {
      margin: 0;
    }
  }
</style>
